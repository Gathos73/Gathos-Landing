# Development proxy for the existing Python backend.
API_PROXY_TARGET=http://localhost:8000
# Public API origin. Defaults to https://api.<VITE_SITE_URL hostname> in builds.
# The backend must allow the landing origin with credentialed CORS.
VITE_API_BASE_URL=https://api.gathos.com
# Public R2 bucket URL or custom domain. Preserve showcase/... object keys.
# May include a prefix if the uploaded public/ folder is nested in the bucket.
VITE_ASSET_BASE_URL=https://assets.vividai.in
# Optional Google Analytics measurement ID.
VITE_GA_ID=
# Public landing origin for links, canonical URLs, and structured data.
VITE_SITE_URL=https://gathos.com
# Dashboard origin; signup and sign-in append /login/.
VITE_DASHBOARD_URL=https://dashboard.gathos.com

# Server-only content API origin used by npm start and Vercel Functions.
# Configure this in the hosting environment (it is not bundled into the browser).
CONTENT_API_URL=https://api.gathos.com
