{
  "name": "gathos-landing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:assets && vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr/server",
    "lint": "eslint .",
    "preview": "vite preview",
